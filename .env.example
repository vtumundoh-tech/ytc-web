# --- Supabase ---
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
# Service role key -> HANYA dipakai di server (API routes), JANGAN pernah diexpose ke browser
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# --- Midtrans ---
# Ambil dari Midtrans Dashboard > Settings > Access Keys
# Pakai key yang diawali "SB-" saat masih Sandbox, tanpa "SB-" saat sudah Production
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Admin ---
# Username untuk login ke halaman /admin (wajib diisi selain password).
ADMIN_USERNAME=admin
# Password untuk login ke halaman /admin. Ganti dengan password yang kuat.
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Password khusus untuk aksi hapus data (panel Admin > Data). Bedakan dari dua password lain.
# Salah input dibatasi 3x per 15 menit per IP.
ADMIN_DELETE_PASSWORD=ganti-dengan-password-hapus-lain
# Password lapisan keamanan pertama (halaman 404 palsu). Bedakan dari ADMIN_PASSWORD.
ADMIN_GATE_PASSWORD=ganti-dengan-gate-password-lain
# String acak panjang untuk menandatangani cookie sesi admin. Boleh generate acak, tidak perlu diingat.
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang
# Secret untuk mengamankan endpoint cron (digest Telegram). Generate acak & simpan.
CRON_SECRET=ganti-dengan-cron-secret-acak

# --- App ---
# URL final aplikasi setelah di-deploy ke Vercel
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- SMTP (Email Otomatis) ---
# Konfigurasi server SMTP untuk mengirim invoice & konfirmasi cashback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email@example.com
SMTP_PASS=ganti-password
# Alamat pengirim (harus terdaftar/valid di SMTP Anda)
MAIL_FROM=MineClip Studios <no-reply@example.com>
# Link Google Drive installer aplikasi (satu link statis untuk semua)
APP_DOWNLOAD_URL=https://drive.google.com/your-app-link

# --- Unduhan Aplikasi (Cloudflare R2) ---
# Bucket R2 privat yang berisi installer & key file di dalamnya.
# Endpoint biasanya berupa: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=app-installer
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_INSTALLER_KEY=MineClipStudios_AI_Lokal.zip

# --- Notifikasi Telegram ---
# Buat bot via @BotFather lalu isi token-nya.
# TELEGRAM_CHAT_ID = chat id admin penerima notif (bisa dilihat via @userinfobot).
# Jika tidak diisi, notifikasi/pesan bot otomatis dilewati (checkout tetap jalan normal).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-xxxxxxxx
TELEGRAM_CHAT_ID=123456789
# Opsional: base URL untuk script polling lokal/VPS (default: http://localhost:3000)
WEBHOOK_BASE_URL=http://localhost:3000
# Secret untuk memberi otorisasi ke /api/telegram/webhook. Wajib jika memakai setWebhook
# (dipassing sebagai header X-Telegram-Bot-Api-Secret-Token). Generate acak & simpan.
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-secret-acak
# Rate limiter terdistribusi (opsional). Kosongkan jika hanya mau fallback in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
